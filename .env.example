# WedPlan local environment template.
# Replit Secrets and shell environment variables take precedence over this file.

# Required for the PostgreSQL-backed API.
DATABASE_URL=postgresql://username:password@localhost:5432/wedplan

# Local web server settings. Replit supplies PORT automatically in preview/deploy.
PORT=5000
BASE_PATH=/
NODE_ENV=development

# Optional application settings.
LOG_LEVEL=info
PAYSTACK_SECRET_KEY=

# Optional object-storage settings used for uploaded assets.
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=