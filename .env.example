# Copy to .env and fill in. Read by the backend and by vite.config.ts.

# MongoDB connection string (local Docker or Atlas).
MONGODB_URI=mongodb://localhost:27017

# Database name. Required - the server refuses to start without it.
MONGODB_DB=wedplan

# Backend port. Vite proxies /api here in development.
PORT=8080

NODE_ENV=development
LOG_LEVEL=info

# Vite dev-server port. Not PORT - that one is the backend's.
FRONTEND_PORT=5173
