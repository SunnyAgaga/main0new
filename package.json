{
  "name": "wedplan",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @wedplan/backend & npm run dev --workspace @wedplan/frontend",
    "build": "npm run build --workspace @wedplan/backend && npm run build --workspace @wedplan/frontend",
    "start": "npm run start --workspace @wedplan/backend",
    "seed": "npm run seed --workspace @wedplan/backend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "codegen": "npm run codegen --workspace @wedplan/shared"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
